// Prisma schema for צדקת רבותינו ordering system
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
}

// לקוחות קצה - הרשמה עצמאית, התחברות עם טלפון או מייל (חובה לפחות אחד)
model Customer {
  id                   String    @id @default(cuid())
  name                 String
  // אחד מהשניים (phone/email) חייב להיות מלא - נאכף בקוד (Prisma לא תומך
  // ב"אחד משני שדות חובה" ברמת הסכמה). שניהם unique כדי למנוע כפילות חשבון.
  phone                String?   @unique
  // טלפון נוסף - ליצירת קשר בעת חלוקה אם הראשי לא עונה
  phone2               String?
  email                String?   @unique
  passwordHash         String
  // סיסמא בטקסט גלוי - נשמרת רק לנציגים/מנהלים כדי שהמנהל יוכל לראות אותה
  // נכתבת רק כשהמנהל מאפס דרך /admin/agents/[id]/reset-password
  // לא נשמרת לסיסמאות ישנות (bcrypt hash אחיד) - במקרה כזה יש להציג הודעה
  //
  // §62 DEPRECATED: הוחלף ב-loginCode המוצפן. נשאר לתאימות אחורה בזמן
  // המעבר ולא נכתב יותר. יוסר אחרי שכל הלקוחות יקבלו loginCode.
  passwordPlain        String?

  // ═══ §62: קוד התחברות ═══
  // קוד מספרי בן 4-6 ספרות שמחליף את הסיסמה. הדרישה התפעולית: לקוח
  // מתקשר "שכחתי קוד", והמנהל רואה מיד את הקוד הפעיל - בלי איפוס,
  // בלי SMS, בלי תהליך שחזור.
  //
  // ⚠️ הקוד **מוצפן** ב-AES-256-GCM (ראה src/lib/login-code.ts) ולא
  // שמור כטקסט גלוי. המנהל עדיין רואה אותו בלחיצה - השרת מפענח
  // בבקשה שלו. ההבדל מתגלה רק אם דלף גיבוי של המסד: בלי המפתח
  // (AUTH_CODE_KEY ב-ENV, שאינו במסד) הערך הזה חסר ערך.
  //
  // למה זה קריטי דווקא כאן: לקוח עם קוד גנוב יכול להיכנס ולהזמין,
  // וההזמנה מחייבת את הטוקן השמור שלו בנדרים.
  loginCode            String?
  loginCodeSetAt       DateTime?
  // §62: הגנה מפני ניחוש. טלפון כשם משתמש + קוד מספרי קצר = מרחב
  // חיפוש קטן, ולכן הנעילה אינה אופציונלית.
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?
  role                 String    @default("CUSTOMER") // CUSTOMER / AGENT / ADMIN
  // נקודת חלוקה ברירת מחדל - נבחרת חובה בהרשמה, ניתנת לשינוי באזור האישי
  defaultPointId       String?
  defaultPoint         DeliveryPoint? @relation(fields: [defaultPointId], references: [id])
  resetToken           String?   @unique
  resetTokenExpiry     DateTime?
  // תשלום ואימות כרטיס - הטוקן מגיע מ-webhook של נדרים אחרי חיוב אימות 1₪ בהרשמה
  paymentToken         String?
  cardLast4            String?
  cardVerifiedAt       DateTime?
  creditVerificationCharged Boolean @default(false)
  // תוקף כרטיס (MM/YY או YYMM כפי שנדרים מחזירים) - נשמר מ-webhook להצגה במסך המנהל
  cardExpiry           String?
  // הפך ל-true כשניסיון חיוב אחרון נכשל בגלל טוקן פסול/כרטיס פג-תוקף.
  // מתאפס ל-false כשנשמר טוקן חדש (webhook רישום חוזר).
  cardNeedsUpdate      Boolean   @default(false)
  // §60: אופן התשלום של הלקוח. CREDIT (ברירת מחדל) / CASH.
  // CASH = לקוח מזדמן שמשלם מזומן בחלוקה: נציג יכול להזמין עבורו בלי
  // כרטיס, החיוב האוטומטי מדלג עליו, והוא לא יכול להזמין באתר בעצמו
  // עד שיוסיף כרטיס. String ולא Boolean - עקבי עם Order.paymentMethod
  // וניתן להרחבה. save-token מחזיר ל-CREDIT אוטומטית כשנשמר טוקן.
  paymentPreference    String    @default("CREDIT")
  // שדות נציג (רלוונטיים רק כאשר role=AGENT)
  // agentPointId: הנקודה שהנציג מוגבל אליה. null = רואה את כל הלקוחות
  // 🔴 DEPRECATED: משתמש בטבלת הקשר AgentPoint (מרובה נקודות). נשאר לתאימות אחורה
  // בזמן המעבר, ולmigration של רשומות ישנות. יוסר בסבב עתידי אחרי וידוא שכל
  // הlogic משתמש ב-agentPoints[].
  agentPointId         String?
  agentPoint           DeliveryPoint? @relation("AgentPoint", fields: [agentPointId], references: [id])
  // 🆕 קשר many-to-many: נציג יכול להיות משויך לכמה נקודות במקביל.
  // בזמן טעינת נציג: `include: { agentPoints: { include: { point: true } } }`
  agentPoints          AgentPoint[]   @relation("AgentPoints")
  // הרשאות נציג נפרדות: קביעת מחיר סופי / שליחת לינק תשלום
  agentCanSetFinalPrice Boolean @default(false)
  agentCanSendPaymentLink Boolean @default(false)
  // הרשאה לחייב לקוח אוטומטית עם טוקן שמור (נדרים)
  agentCanCharge Boolean @default(false)
  // הרשאה לעדכן פרטי אשראי של לקוח (החלפת token)
  agentCanUpdateCards Boolean @default(false)
  // §24: איפוס סיסמה ללקוח. נדרש בעיקר ללקוחות טלפוניים - הם נרשמים
  // בשיחה עם סיסמה אקראית שאיש לא יודע, ולרוב בלי מייל, כך ש"שכחתי
  // סיסמה" לא עוזר להם. הנציג ממילא מדבר איתם כדי לעדכן כרטיס.
  // כבוי כברירת מחדל: סיסמה נותנת גישה מלאה לחשבון ולהיסטוריה, וזה
  // סוג גישה שונה מעדכון כרטיס.
  agentCanResetPassword Boolean @default(false)
  // עמלת נציג לפי ק"ג - קרטונים ובודדים בנפרד
  // ברירת מחדל: 1 ש"ח לק"ג לקרטונים, 4 ש"ח לק"ג לבודדים (1 בסיסי + 3 תוספת)
  commissionRateCarton  Decimal @default(1) @db.Decimal(10, 2)
  commissionRateSingles Decimal @default(4) @db.Decimal(10, 2)
  orders               Order[]
  personalRequests     PersonalRequest[]
  // §24: מערכת טלפונית
  phoneDrafts          PhoneOrderDraft[]
  phoneMessages        PhoneMessage[]
  phoneSignupRequests  PhoneSignupRequest[]
  // §20: מכירות ותשלומים של הנציג
  agentSaleSummaries   AgentSaleSummary[]
  agentPayments        AgentPayment[]
  walkinOrders         WalkinOrder[] @relation("WalkinAgent")
  // האם המשתמש כבר ראה את מסך "ברוכים הבאים" של ההזמנה (מוצג פעם אחת בלבד)
  hasSeenOrderIntro    Boolean   @default(false)
  // חשבון "פסיבי" - נוצר ע"י נציג בשם הלקוח, הלקוח עוד לא הפעיל אותו.
  // כשהלקוח יעשה "שכחתי סיסמה" ויגדיר סיסמא בעצמו - יהפוך ל-true.
  isActivated          Boolean   @default(true)
  // מזהה הנציג שיצר את הלקוח (רק אם נוצר ע"י נציג, לתיעוד)
  createdByAgentId     String?
  // הסכמה לקבלת מיילים שיווקיים (עדכוני מכירות, הודעות כלליות).
  // מיילים תפעוליים (אישור הזמנה/חיוב) לא תלויים בזה - הם חלק מהשירות.
  // נשאל פעם אחת בהרשמה. ברירת מחדל false כדי שהמערכת לא תשלח בטעות.
  agreedToEmails       Boolean   @default(false)
  // תאריך ההסכמה - חשוב לתיעוד רגולטורי (GDPR/CAN-SPAM) ולהוכחת הסכמה במחלוקת.
  agreedToEmailsAt     DateTime?

  // §52: לקוח לא פעיל.
  //
  // למה לא מחיקה: ללקוח יש היסטוריית הזמנות, חיובים ותעודות שחייבים
  // להישמר - גם לתיעוד וגם כי מחיקה תשבור דוחות של מכירות עבר.
  //
  // לקוח לא פעיל: לא מקבל מיילים (כולל תפעוליים - הוא לא מזמין),
  // לא מופיע בברודקסט ובתזכורות, לא מופיע בחיפוש הרגיל של הנציג,
  // ולא יכול לבצע הזמנה חדשה. ההיסטוריה שלו נשארת שלמה.
  isActive             Boolean   @default(true)
  deactivatedAt        DateTime?
  deactivatedReason    String?

  // §22: הסכמה לתנאי השימוש ולמדיניות הפרטיות.
  // עד כה הצ'קבוקס נאכף בטופס ההרשמה בלבד ולא נשמר בשום מקום, כלומר לא
  // הייתה שום הוכחה שהלקוח אישר. זו ההסכמה שמכסה את החיוב האוטומטי
  // בכרטיס האשראי ואת מדיניות הביטולים - בדיוק מה שיידרש במחלוקת.
  // termsVersion מאפשר לזהות *לאיזו גרסה* של התנאים הלקוח הסכים,
  // כדי שעדכון עתידי של התנאים לא יטשטש את התיעוד ההיסטורי.
  agreedToTerms        Boolean   @default(false)
  agreedToTermsAt      DateTime?
  termsVersion         String?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String
  sortOrder Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id            String   @id @default(cuid())
  name          String
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  // מחיר קרטון הוא ברירת המחדל המוצגת מהמחירון
  cartonPrice   Decimal  @db.Decimal(10, 2)
  // §24: תפריט טלפוני. phoneKey = הספרה שהלקוח מקיש לבחירת המוצר בתפריט
  // הקולי (קבוע לאורך זמן כדי שלקוחות קבועים יזכרו אותו).
  // §69: מק"ט טלפוני. המנהל קובע מספר קצר (למשל 101) ומפרסם אותו
  // במודעה; הלקוח מקיש אותו בטלפון והמוצר עולה מיד - בלי לשמוע את
  // כל התפריט. unique כדי שהקשה תוביל תמיד למוצר אחד; NULL מותר
  // לכמה מוצרים (Postgres לא אוכף unique על NULL).
  phoneCode     String?  @unique
  // §69: כתיב פונטי להקראה. ה-TTS של ימות משבש חלק מהשמות
  // ("אנטריקוט"); כאן כותבים איך שזה צריך *להישמע* ("אנטרי קוט").
  // ריק = מקריאים את השם הרגיל. משפיע רק על הטלפון, לא על האתר.
  phoneName     String?
  // phoneEnabled = האם להציע את המוצר בטלפון בכלל.
  phoneKey      Int?
  phoneEnabled  Boolean  @default(true)

  // האם המוצר תומך בקנייה בבודדים (בשר/דגים) עם תוספת לק"ג
  allowSingles  Boolean  @default(false)
  // תוספת מחיר לבודדים לק"ג (ברירת מחדל 3 ש"ח, ניתן לעריכה גלובלית/למוצר)
  singleSurcharge Decimal? @db.Decimal(10, 2)
  // מצב בודדים: KG = לפי ק"ג (בשר, ברירת מחדל) / UNITS = לפי יחידות (סלומון וכד')
  singlesMode      String   @default("KG")
  // מחיר קבוע ליחידה בבודדים - נדרש כאשר singlesMode="UNITS"
  singleUnitPrice  Decimal? @db.Decimal(10, 2)
  unit          String   @default("ק\"ג") // ק"ג / יחידה / מארז
  saleType      String   @default("WEIGHT") // WEIGHT / UNIT / PACKAGE
  // סוג המחיר: REGULAR (מחיר רגיל לק"ג/יחידה/מארז) / CARTON (מחיר קרטון, בודדים בתוספת)
  priceType     String   @default("REGULAR") // REGULAR / CARTON
  packageWeight String?  // 200 גרם / 400 גרם / 500 גרם / 900 גרם
  // משקל ממוצע משוער ליחידה/קרטון - משמש לחישוב מחיר משוער מדויק יותר ללקוח
  avgWeightPerUnit Decimal? @db.Decimal(10, 3)
  imageUrl      String?  // תמונת המוצר (Supabase Storage)
  kashrut       String?  // כשרות (legacy - טקסט חופשי, לתאימות)
  // כשרות מרשימה מרוכזת - יש לו גם שם וגם תמונה מנוהלים ע"י המנהל
  kashrutId     String?
  kashrutRef    Kashrut? @relation(fields: [kashrutId], references: [id])
  isFeatured    Boolean  @default(false) // מוצר מבצע - מודגש ללקוח
  highlightNote String?  // הערת הדגשה ("בקרטונים בלבד - לא בבודדים")
  isFrozen      Boolean  @default(false)
  limitedQty    Boolean  @default(false)
  limitedQtyAmount Int?   // מגבלת כמות שהמנהל מגדיר (תצוגה/אזהרה בלבד, לא חוסם לקוח)
  // §9: האם המוצר זמין להזמנה אישית (מלבד מכירות רגילות)
  allowPersonalOrder Boolean @default(true)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  orderItems    OrderItem[]
  pricelists    PricelistProduct[]
  // §20: מודול נציגים
  deliveryNoteItems DeliveryNoteItem[]
  walkinOrderItems  WalkinOrderItem[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  supplierPlans SupplierOrderPlan[]
}

model DeliveryPoint {
  // §69: כתיב פונטי להקראת שם הנקודה והעיר בטלפון. ריק = השם הרגיל.
  phoneName     String?
  cityPhoneName String?
  id           String   @id @default(cuid())
  name         String
  city         String?
  address      String?
  contactName  String?
  phone        String?
  email        String?
  deliveryHours String?
  // §6: תאריך חלוקה חריג לנקודה זו (עדיף על deliveryDateText של המחירון)
  // אם null - משתמשים בתאריך של המחירון. אם קיים - הנקודה מקבלת בתאריך שונה.
  // שימושי לחגים, לנקודות עם מועד קבלה שונה, וכד'.
  customDeliveryDateText String?
  notes        String?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  orders       Order[]
  pricelists   PricelistPoint[]
  customers    Customer[] // לקוחות שבחרו נקודה זו כברירת מחדל
  agents       Customer[] @relation("AgentPoint") // 🔴 DEPRECATED: נציגים המוגבלים לנקודה זו (single). נשאר לתאימות.
  // 🆕 קשר many-to-many: כל הנציגים המשויכים לנקודה דרך AgentPoint
  agentPoints  AgentPoint[] @relation("PointAgents")
  phoneSignupRequests PhoneSignupRequest[]
  walkinOrders WalkinOrder[]
  phoneAnnouncements  PhoneAnnouncement[]
  personalProducts PersonalProduct[] @relation("PersonalProductPoint") // §9: מוצרים אישיים בנקודה זו
  createdAt    DateTime @default(now())
  supplierPlans SupplierOrderPlan[]
}

// טבלת קשר: נציג <-> נקודת חלוקה (many-to-many).
// לפני שינוי זה, לכל נציג הייתה בדיוק נקודה אחת (`Customer.agentPointId`).
// עכשיו הנציג יכול להיות משויך לכמה נקודות במקביל, וכל שיוך נשמר כרשומה כאן.
model AgentPoint {
  id        String   @id @default(cuid())
  agentId   String
  agent     Customer @relation("AgentPoints", fields: [agentId], references: [id], onDelete: Cascade)
  pointId   String
  point     DeliveryPoint @relation("PointAgents", fields: [pointId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // נציג יכול להיות משויך פעם אחת בלבד לכל נקודה
  @@unique([agentId, pointId])
  // חיפוש מהיר של כל הנציגים בנקודה מסוימת
  @@index([pointId])
}

model Pricelist {
  id            String   @id @default(cuid())
  name          String
  openDate      DateTime?
  closeDate     DateTime?
  // §16: עד מתי לקוח יכול לערוך/לבטל הזמנה קיימת (אם null - fallback ל-closeDate)
  editDeadline  DateTime?
  deliveryDate  DateTime?
  // §6/#6: תאריך חלוקה סוף — אם חלוקה מתפרסת על מספר ימים
  deliveryDateEnd DateTime?
  deliveryDateText String?  // טקסט חופשי לתאריך עברי

  // §111: מכירה לנציגים בלבד ("הזמנה מהירה").
  //
  // מכירה רגילה פתוחה ללקוח: הוא נכנס לאתר או מתקשר ומזמין לבד.
  // מכירה כזו **אינה מוצגת ללקוח כלל** - לא באתר, לא ב-IVR - והנציג
  // הוא היחיד שפותח בה הזמנות, מתוך כרטיס כל לקוח בנפרד.
  //
  // למה זה קיים: יש נקודות שבהן לקוחות מזמינים כל יומיים, מחוץ
  // למחזור המכירה הרגיל. עד היום הנציג רכש עבורם וגבה אחר כך -
  // מה שהצטבר לחובות. כאן ההזמנה עוברת במחזור המלא של המערכת:
  // מחיר מהמחירון, שקילה בחלוקה, וחיוב אוטומטי בכרטיס של הלקוח.
  //
  // ⚠️ החיוב זהה למכירה רגילה. אין כאן מסלול עוקף - זו כל הנקודה.
  agentOnly        Boolean  @default(false)
  notes         String?
  status        String   @default("DRAFT") // DRAFT / ACTIVE / CLOSED / DONE
  singleSurcharge Decimal @default(3) @db.Decimal(10, 2) // תוספת לבודדים גלובלית למחירון
  // דמי הזמנה קבועים - תוספת חד-פעמית לכל הזמנה
  orderFee Decimal @default(3) @db.Decimal(10, 2)
  points        PricelistPoint[]
  products      PricelistProduct[]
  orders        Order[]
  // §20: מודול נציגים
  agentSaleSummaries AgentSaleSummary[]
  deliveryNotes     DeliveryNote[]
  walkinOrders      WalkinOrder[]
  agentPayments     AgentPayment[]
  phoneAnnouncements PhoneAnnouncement[]
  createdAt     DateTime @default(now())
  supplierPlans SupplierOrderPlan[]
}

model PricelistPoint {
  id            String   @id @default(cuid())
  pricelistId   String
  pricelist     Pricelist @relation(fields: [pricelistId], references: [id], onDelete: Cascade)
  pointId       String
  point         DeliveryPoint @relation(fields: [pointId], references: [id], onDelete: Cascade)
  @@unique([pricelistId, pointId])
}

model PricelistProduct {
  id          String   @id @default(cuid())
  pricelistId String
  pricelist   Pricelist @relation(fields: [pricelistId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  // מחיר ספציפי למחירון (אם null נופל חזרה למחיר המוצר)
  price       Decimal?  @db.Decimal(10, 2)
  @@unique([pricelistId, productId])
}

model Order {
  id              String   @id @default(cuid())
  orderNumber     Int      @unique @default(autoincrement())
  pricelistId     String?
  pricelist       Pricelist? @relation(fields: [pricelistId], references: [id])
  pointId         String
  point           DeliveryPoint @relation(fields: [pointId], references: [id])
  // כל הזמנה משויכת ללקוח רשום (אין יותר הזמנת אורח)
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  // §24: מקור ההזמנה - מאיפה היא הגיעה בפועל.
  // WEB   = הלקוח הזמין בעצמו באתר
  // PHONE = הזמנה שהתקבלה במערכת הטלפונית (ימות המשיח)
  // AGENT = נציג הזמין בשם הלקוח
  // EXCEL = הלקוח מילא קובץ אקסל ושלח במייל
  // ADMIN = המנהל יצר ידנית
  // משלים את placedByAgentId: הוא אומר *מי* הזמין, source אומר *דרך מה*.
  source          String   @default("WEB")
  // מזהה השיחה בימות המשיח (ApiCallId) - לתחקור הזמנה טלפונית מול הלוגים
  phoneCallId     String?

  // snapshot של מה שהלקוח ראה/הזין בזמן ההזמנה (לתיעוד - לא משתנה גם אם הלקוח עצמו ישתנה אחר כך)
  pointNameSnapshot     String?
  deliveryDateSnapshot  String?
  pricelistNameSnapshot String?

  // §21: סימון מסירה בפועל ע"י הנציג בנקודת החלוקה.
  // המערכת לא יודעת לבד מי קיבל - הנציג הוא היחיד שנמצא שם ורואה את הלקוח.
  // deliveredByAgentId הוא שדה חופשי בלי relation, בכוונה, כדי שהתיעוד
  // "מי מסר" ישרוד גם אם הנציג יימחק מהמערכת בעתיד.
  deliveredAt        DateTime?
  deliveredByAgentId String?
  deliveredNote      String?

  customerName    String
  phone           String
  phone2          String?
  notes           String?
  internalNotes   String?

  // §103: סימון הנציג שסיים לטפל בהזמנה בחלוקה.
  //
  // "כל המשקלים מולאו" הוא נתון שהמערכת מחשבת; זה הצהרה של הנציג
  // שהוא עבר על הלקוח וסיים. שני דברים שונים: הזמנה יכולה להיות
  // מלאה במשקלים אבל הנציג עדיין לא בדק אותה מול הלקוח.
  //
  // המנהל משדר לתשלום רק הזמנות שסומנו - כך הוא יודע שמישהו
  // באמת עמד מולן, ולא סומך על כך שהשדות אינם ריקים.
  agentClosedAt   DateTime?
  agentClosedById String?

  // מחזור חיים: PENDING_REVIEW -> FINAL_PRICE_SET -> PAYMENT_PENDING -> PAID -> READY_FOR_PICKUP -> COMPLETED
  // (או CANCELLED בכל שלב)
  status          String   @default("PENDING_REVIEW")

  estimatedTotal  Decimal  @db.Decimal(10, 2) // מחיר משוער בזמן ההזמנה
  // §13: מספר תשלומים שהלקוח ביקש (1 = רגיל, 2 = שני תשלומים מעל 800₪)
  requestedInstallments Int @default(1)
  finalTotal      Decimal? @db.Decimal(10, 2) // מחיר סופי אחרי שקילה ע"י נציג/מנהל

  // תשלום - משתנים אך ורק מהשרת (admin API מאומת עם תפקיד מורשה, או webhook חתום מהסולק). אף פעם לא מהדפדפן.
  // PENDING (טרם נקבע מחיר סופי) / PAYMENT_PENDING (ממתין לתשלום אונליין) / PAID / PARTIALLY_PAID / FAILED / REFUNDED
  paymentStatus       String    @default("PENDING")
  // ONLINE (אונליין דרך נדרים) / CASH (מזומן בשטח) / BANK_TRANSFER / MANUAL
  paymentMethod        String?
  paymentLink          String?
  amountPaid            Decimal?  @db.Decimal(10, 2) // מה שבפועל שולם (יכול להיות שונה מ-finalTotal)
  paidAt                DateTime?
  paymentTransactionId String?
  paymentProvider      String?   // למשל "nedarim_plus"
  // מודול חיוב אוטומטי (§19) - מעקב אחרי ניסיונות חיוב עם הטוקן השמור של הלקוח
  chargeAttempts       Int       @default(0)
  lastChargeError      String?
  lastChargeAt         DateTime?
  // תשלום מזומן - תיעוד חובה
  receivedByUserId     String?   // מזהה/מייל המנהל-נציג שקיבל את הכסף בפועל
  manualPaymentNote    String?

  // מתי אישרו אדמין/נציג מחיר סופי, ומי
  finalPriceSetAt DateTime?
  finalPriceSetBy String?
  // אם ההזמנה בוצעה ע"י נציג בשם הלקוח - מזהה הנציג
  placedByAgentId String?   // email של המנהל/נציג שעדכן

  // מעקב אישורים שנשלחו (לא מפיל את ההזמנה אם נכשל - רק לוג)
  adminNotifiedAt    DateTime?
  adminNotifyError   String?
  customerNotifiedAt DateTime?
  customerNotifyError String?

  items           OrderItem[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  productName   String   // snapshot
  unit          String
  isSingle      Boolean  @default(false) // נקנה בבודדים (תוספת)
  quantity      Decimal  @db.Decimal(10, 3)
  unitPrice     Decimal  @db.Decimal(10, 2) // מחיר ליחידה ששמור בהזמנה (snapshot)
  estimatedWeight Decimal? @db.Decimal(10, 3) // משקל משוער (לפי avgWeightPerUnit של המוצר, אם קיים)
  estimatedPrice Decimal @db.Decimal(10, 2)
  actualWeight  Decimal? @db.Decimal(10, 3) // משקל בפועל - מעודכן ע"י נציג/מנהל אחרי שקילה
  finalWeight   Decimal? @db.Decimal(10, 3) // נשמר לתאימות לאחור (זהה ל-actualWeight)
  finalPrice    Decimal? @db.Decimal(10, 2)
  // §20: שדות של נציג - נעולים לחישוב עמלה (המנהל יכול לתקן finalWeight, אבל agentEnteredWeight נשמר)
  agentEnteredWeight Decimal? @db.Decimal(10, 3) // המשקל שהנציג הזין - נעול לעמלה
  agentEnteredById   String?  // מזהה הנציג שהזין (Customer.id)
  agentNote          String?  // הערה חופשית מהנציג ("הגיע צלעות במקום כתפיים")
  isCancelled        Boolean  @default(false) // לקוח לא רצה - לא מחייבים
  originalProductId  String?  // מוצר מקורי לפני החלפה (לתיעוד)
}

// הגדרות מערכת גלובליות - שורה יחידה, נערכת מאזור הניהול
model SystemSettings {
  id                    String  @id @default("singleton")
  adminEmail            String  @default("m5402088@gmail.com")
  adminWhatsappPhone    String?
  sendEmailToCustomer   Boolean @default(true)
  sendEmailToAdmin      Boolean @default(true)
  customerEmailTemplate String? // נוסח חופשי, null = ברירת המחדל הקבועה בקוד
  adminEmailTemplate    String?
  personalOrdersEnabled Boolean @default(false) // מתג מודול הזמנות אישיות
  updatedAt             DateTime @updatedAt
}

// תיעוד audit לכל סימון תשלום ידני (מזומן/העברה) - לא נמחק לעולם, רק נוסף
model PaymentAuditLog {
  id              String   @id @default(cuid())
  orderId         String
  action          String   // "MANUAL_CASH_PAYMENT" / "REFUND" / וכו'
  amountPaid      Decimal  @db.Decimal(10, 2)
  finalTotalAtTime Decimal @db.Decimal(10, 2) // מה היה finalTotal ברגע הסימון, לתיעוד
  paymentMethod   String   // CASH / BANK_TRANSFER / MANUAL
  receivedByUserId String  // מי ביצע את הפעולה (חובה - אין רישום אנונימי)
  note            String?
  createdAt       DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════
// מודול הזמנות אישיות - נפרד לחלוטין ממערכת המכירות
// ═══════════════════════════════════════════════════════════

// §9 מיושן: המודל הישן של מוצרים אישיים.
// היום מוצרי המחירון (Product) עם `allowPersonalOrder=true` משמשים גם להזמנות אישיות.
// הטבלה נשמרת כרגע ליישום המנהל, אבל לא בשימוש חדש.
model PersonalProduct {
  id          String   @id @default(cuid())
  name        String
  imageUrl    String?
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  maxQuantity Int?
  stock       Int?
  pointId     String?
  point       DeliveryPoint? @relation("PersonalProductPoint", fields: [pointId], references: [id])
  createdAt   DateTime @default(now())
}

// בקשת הזמנה אישית של לקוח
model PersonalRequest {
  id           String   @id @default(cuid())
  requestNumber Int     @unique @default(autoincrement())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  customerName String   // snapshot
  phone        String   // snapshot
  notes        String?
  status       String   @default("NEW") // NEW/IN_PROGRESS/CONTACTED/WAITING/DONE/CANCELLED
  // §9: מסמן שיש הודעה חדשה שלא נקראה (מנהל / לקוח)
  hasUnreadForAdmin    Boolean @default(true)
  hasUnreadForCustomer Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  items        PersonalRequestItem[]
  messages     PersonalRequestMessage[]
}

model PersonalRequestItem {
  id         String          @id @default(cuid())
  requestId  String
  request    PersonalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  // §9: productId כמחרוזת ללא FK - יכול להצביע ל-Product רגיל.
  // אין FK כדי לאפשר migration בטוח מ-PersonalProduct הישן ל-Product החדש.
  // ה-productName נשמר כ-snapshot ומספיק לתצוגה.
  productId  String
  productName String
  quantity   Int
  // §73: בודדים או קרטונים - כמו בהזמנה רגילה. המחיר נקבע ממילא
  // בצ'אט עם המנהל, אבל הוא חייב לדעת *מה* הלקוח מבקש: קרטון
  // שלם או קילוגרמים בודדים.
  isSingle   Boolean         @default(false)
}

// §9: הודעות בין לקוח למנהל בבקשה אישית
model PersonalRequestMessage {
  id         String   @id @default(cuid())
  requestId  String
  request    PersonalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  senderType String   // "CUSTOMER" / "ADMIN"
  senderName String   // snapshot של שם השולח
  message    String   @db.Text
  createdAt  DateTime @default(now())

  @@index([requestId])
}

// ═══════════════════════════════════════════════════════════════
// §20: מודול נציגים - חלוקה, משקלים, עמלות, תעודות משלוח, מזדמנים
// ═══════════════════════════════════════════════════════════════

// סיכום עבודת נציג במכירה ספציפית - מחושב חי, נעול בסוף
model AgentSaleSummary {
  id                  String   @id @default(cuid())
  pricelistId         String
  pricelist           Pricelist @relation(fields: [pricelistId], references: [id], onDelete: Cascade)
  agentId             String
  agent               Customer  @relation(fields: [agentId], references: [id])
  // סיכומים - מחושבים ונשמרים בסגירת המכירה על ידי הנציג
  totalCartonWeight   Decimal   @default(0) @db.Decimal(10, 3) // ק"ג קרטונים ללקוחות
  totalSinglesWeight  Decimal   @default(0) @db.Decimal(10, 3) // ק"ג בודדים
  totalWalkinWeight   Decimal   @default(0) @db.Decimal(10, 3) // ק"ג מזדמנים
  totalCustomers      Int       @default(0) // מספר לקוחות שטופלו
  totalWalkins        Int       @default(0) // מספר מזדמנים
  cartonCommission    Decimal   @default(0) @db.Decimal(10, 2) // עמלה על קרטונים
  singlesCommission   Decimal   @default(0) @db.Decimal(10, 2) // עמלה על בודדים
  totalCommission     Decimal   @default(0) @db.Decimal(10, 2) // עמלה כוללת
  // "נותר/זרוק" - להסבר פערים מתעודת המשלוח
  remainderNote       String?   @db.Text
  // סטטוס: DRAFT (בעריכה) / CONFIRMED (נציג סגר את המכירה)
  status              String    @default("DRAFT")
  confirmedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([pricelistId, agentId])
  @@index([status])
}

// תעודת משלוח מהספק - מועלית ע"י המנהל, מאושרת ומשמשת מקור אמת לק"ג קרטונים
model DeliveryNote {
  id             String   @id @default(cuid())
  pricelistId    String
  pricelist      Pricelist @relation(fields: [pricelistId], references: [id])
  // תמונה מקורית שהמנהל צילם/העלה
  imageUrl       String?
  // נתונים גולמיים כפי שחזרו מ-Gemini (JSON)
  ocrRawData     String?  @db.Text
  // פרטים שחולצו לגבי התעודה עצמה
  supplierName   String?  // שם הספק (למשל "לנדה סחר")
  noteNumber     String?  // מספר תעודה
  noteDate       DateTime? // תאריך התעודה
  // סטטוס: DRAFT (רק חולץ ע"י OCR) / CONFIRMED (המנהל אישר) / REJECTED
  status         String   @default("DRAFT")
  confirmedById  String?  // מזהה מי אישר
  confirmedAt    DateTime?
  items          DeliveryNoteItem[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([pricelistId])
  @@index([status])
}

// שורת מוצר בתעודת משלוח - כל שורה = מוצר אחד עם קרטונים ומשקל
model DeliveryNoteItem {
  id              String       @id @default(cuid())
  deliveryNoteId  String
  deliveryNote    DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  // productId - שיוך למוצר במערכת. NULL אם עדיין לא הותאם
  productId       String?
  product         Product?     @relation(fields: [productId], references: [id])
  // השם כפי שהופיע בתעודה (לפני התאמה)
  productNameOnNote String
  quantity        Int          // מספר קרטונים
  weight          Decimal      @db.Decimal(10, 3) // סה"כ ק"ג לפי התעודה
  // אמון של Gemini - 0.0 עד 1.0. שורה עם confidence נמוך מסומנת אדום למנהל
  confidence      Decimal?     @db.Decimal(3, 2)
  // האם המנהל הוסיף את השורה ידנית (אחרי OCR)
  addedManually   Boolean      @default(false)
  // הערה חופשית (למשל: "שם לא ברור בתעודה")
  note            String?
  sortOrder       Int          @default(0)

  // §113: עלות בפועל מהספק, לק"ג.
  //
  // הפער שנסגר: התעודה תיעדה **כמה הגיע** אבל לא **כמה זה עלה**,
  // ולכן אי אפשר היה לענות על השאלה הבסיסית - "קניתי ב-X, גביתי
  // Y, מה נשאר". בלי זה כל הדוחות מציגים מחזור ולא רווח.
  //
  // ⚠️ לק"ג ולא לקרטון: ספק בשר מחייב לפי משקל, והקרטון הוא יחידת
  // אריזה בלבד. שמירת מחיר לקרטון הייתה מייצרת חישוב שגוי בכל
  // פעם שמשקל הקרטון סוטה מהתכנון - כלומר תמיד.
  costPerKg       Decimal?     @db.Decimal(10, 2)
}

// לקוח מזדמן - הגיע לחלוקה בלי הזמנה מוקדמת
model WalkinOrder {
  id              String   @id @default(cuid())
  walkinNumber    Int      @unique @default(autoincrement()) // מספר מזדמן רץ
  pricelistId     String
  pricelist       Pricelist @relation(fields: [pricelistId], references: [id])
  agentId         String
  agent           Customer  @relation("WalkinAgent", fields: [agentId], references: [id])

  // §44: נקודת החלוקה שבה נרשם המזדמן.
  // עד כה המזדמן היה מקושר לנציג בלבד, ולכן לא ניתן היה לשייך אותו
  // לנקודה - מה שהשאיר אותו מחוץ לכל פירוט לפי נקודה, כולל בחישוב
  // העמלות מול הנציג.
  // אופציונלי בכוונה: מזדמנים שנוצרו לפני השינוי יישארו בלי שיוך,
  // ועדיף להציג אותם כ"ללא נקודה" מאשר לנחש שיוך שגוי.
  pointId         String?
  point           DeliveryPoint? @relation(fields: [pointId], references: [id])

  // פרטי הלקוח - שם חובה, טלפון אופציונלי (אבל מומלץ ל-SMS)
  customerName    String
  customerPhone   String?
  customerEmail   String?
  // אמצעי תשלום
  paymentMethod   String   // CASH / CARD_TERMINAL / TRANSFER / ONLINE / CARD_ONLINE
  // האם התקבל בפועל - לתשלומים כמו העברה בנקאית שצריך לוודא
  paymentReceived Boolean  @default(true)  // ברירת מחדל true (מזומן / אשראי במסוף = מיד)
  // הערה על התשלום (למשל: "4 ספרות אחרונות: 4523, אישור: 123456")
  paymentNote     String?
  // סה"כ הזמנה
  totalAmount     Decimal  @default(0) @db.Decimal(10, 2)
  // הערות כלליות
  notes           String?
  // תיעוד שליחת סיכומים
  summarySentAt   DateTime? // מתי נשלח סיכום (וואטסאפ / מייל)
  summarySentVia  String?   // "WHATSAPP" / "EMAIL"
  items           WalkinOrderItem[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([pricelistId])
  @@index([agentId])
  @@index([paymentMethod, paymentReceived])
}

// פריט של הזמנת מזדמן
model WalkinOrderItem {
  id              String   @id @default(cuid())
  walkinOrderId   String
  walkinOrder     WalkinOrder @relation(fields: [walkinOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  productName     String   // snapshot
  weight          Decimal  @db.Decimal(10, 3) // ק"ג בפועל
  unitPrice       Decimal  @db.Decimal(10, 2) // מחיר ליחידה בזמן ההזמנה
  isSingle        Boolean  @default(false)   // בודדים
  totalPrice      Decimal  @db.Decimal(10, 2) // weight × unitPrice
  note            String?
}

// תשלום שהמנהל שילם לנציג - היסטוריה + מעקב חוב
model AgentPayment {
  id            String   @id @default(cuid())
  agentId       String
  agent         Customer @relation(fields: [agentId], references: [id])
  amount        Decimal  @db.Decimal(10, 2) // סכום ששולם (חיובי) או שנציג חייב (שלילי)
  // סוג: PAID (המנהל שילם לנציג) / COLLECTED (הנציג העביר מזומן שאסף)
  type          String
  // אמצעי תשלום
  method        String?  // BANK_TRANSFER / CASH / CHECK / OTHER
  note          String?  @db.Text // הערה חופשית ("מזומן שאסף בחלוקה של יום ראשון")
  // קישור למכירה ספציפית (אופציונלי - יכול להיות תשלום כללי)
  pricelistId   String?
  pricelist     Pricelist? @relation(fields: [pricelistId], references: [id])
  createdById   String?  // מזהה המנהל שרשם
  createdAt     DateTime @default(now())

  @@index([agentId])
  @@index([pricelistId])
}

// כשרויות מרוכזות - מנוהלות ע"י המנהל, נבחרות בכל מוצר, מוצגות ללקוח.
// יתרון: המנהל מגדיר פעם אחת שם ותמונה, בכל מוצר בוחר מהרשימה.
model Kashrut {
  id        String    @id @default(cuid())
  name      String    @unique // "בד"ץ העדה החרדית" / "לנדא" / "אגודת ישראל"
  imageUrl  String    // תמונת הלוגו של הכשרות (Supabase Storage)
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ═══════════════════════════════════════════════════════════════════
// §24: מערכת טלפונית (ימות המשיח)
// ═══════════════════════════════════════════════════════════════════

// טיוטת הזמנה טלפונית - מצב השיחה בזמן אמת.
//
// למה טבלה ולא פרמטרים ב-URL: ימות שולחים בכל קריאה את כל הנתונים
// שנאספו, אבל לקוח שבוחר 5 מוצרים מייצר URL ארוך שעלול להישבר.
// בנוסף, טיוטה שמורה מאפשרת לתחקר שיחות שהתנתקו באמצע ולראות
// איפה לקוחות נתקעים.
//
// המחיקה: ימות שולחים hangup=yes בניתוק, ואז הטיוטה נמחקת אם ההזמנה
// לא הושלמה. טיוטות יתומות (ניתוק שלא דווח) מנוקות לפי createdAt.
model PhoneOrderDraft {
  id            String   @id @default(cuid())
  // ApiCallId של ימות - מזהה ייחודי לאורך כל השיחה
  callId        String   @unique
  phone         String
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  pricelistId   String?
  // הפריטים שנבחרו עד כה, כ-JSON:
  // [{ productId, productName, isSingle, quantity, unitPrice, estimatedPrice }]
  // JSON ולא טבלת בת, כי זו טיוטה זמנית שנמחקת בסיום ואין צורך בשאילתות עליה.
  itemsJson     String?
  // ההזמנה שנוצרה בסוף (אם הושלמה) - לתיעוד ולמניעת יצירה כפולה
  orderId       String?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([phone])
  @@index([createdAt])
}

// הודעה שלקוח השאיר במערכת הטלפונית.
//
// מיועד לשני מצבים: לקוח לא רשום שמבקש שיחזרו אליו, ולקוח רשום
// שרוצה למסור משהו שלא נכנס לתפריט. המנהל מטפל בהן מהאתר.
model PhoneMessage {
  id           String   @id @default(cuid())
  phone        String
  callId       String?
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // נתיב ההקלטה בימות (אם הלקוח הקליט) או תמלול
  recordingPath String?
  transcript   String?
  // סוג הפנייה: CALLBACK = מבקש שיחזרו אליו, GENERAL = הודעה כללית
  kind         String   @default("GENERAL")
  // טיפול: NEW -> HANDLED
  status       String   @default("NEW")
  handledAt    DateTime?
  handledBy    String?
  adminNote    String?
  createdAt    DateTime @default(now())

  @@index([status])
  @@index([phone])
}

// בקשת פתיחת חשבון שהתקבלה במערכת הטלפונית.
//
// זו לא "הודעה" אלא *משימה מנוהלת*: לקוח שנרשם בטלפון לא יכול להזמין
// עד שנציג ייצור איתו קשר ויעדכן פרטי אשראי (אין דרך להזין כרטיס
// בטלפון בלי לעבור בסולק). הטבלה מחזיקה את מצב הטיפול.
//
// השיוך הוא לפי *נקודת חלוקה* ולא לנציג ספציפי - הבקשה מופיעה לכל
// נציג שמשויך לאותה נקודה. assignedAgentId הוא עקיפה ידנית של המנהל
// כשהוא רוצה שנציג מסוים יטפל.
//
// הלקוח נוצר כבר בשלב הרישום הטלפוני (בלי טוקן), ולכן customerId
// מלא מההתחלה. הוא חסום מהזמנה ממילא כל עוד אין paymentToken.
model PhoneSignupRequest {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  phone         String
  customerName  String
  // נקודת החלוקה שהלקוח בחר בשיחה - זהו גם השיוך לטיפול
  pointId       String
  point         DeliveryPoint @relation(fields: [pointId], references: [id])
  // עקיפה ידנית: המנהל משייך נציג ספציפי במקום "כל נציגי הנקודה"
  assignedAgentId String?
  assignedAt      DateTime?

  // NEW -> ASSIGNED -> CONTACTED -> COMPLETED / FAILED
  // COMPLETED נקבע אוטומטית כשנוצר ללקוח paymentToken.
  status        String   @default("NEW")
  contactedAt   DateTime?
  contactedBy   String?
  completedAt   DateTime?
  // סיבה כשהטיפול נכשל (לא עונה, ויתר, מספר שגוי)
  failReason    String?
  note          String?

  callId        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([pointId])
  @@index([customerId])
}

// §30: הודעה קולית למתקשרים למערכת הטלפונית.
//
// למה: לקוח טלפוני אין לו מייל, ולכן עדכונים ("החלוקה נדחתה לשעה 18:00")
// לא מגיעים אליו. ההודעה מוקראת בכניסה לשיחה, ומשמשת גם כיעד לצינתוק -
// הלקוח רואה שיחה שלא נענתה, מתקשר חזרה, ושומע את העדכון.
//
// הסינון קריטי: הודעה לא רלוונטית גרועה מאין הודעה. מוקראת רק למי
// שיש לו הזמנה פעילה במכירה, ורק אם היא מיועדת לנקודה שלו.
// pointId ריק = הודעה גלובלית לכל הנקודות במכירה.
model PhoneAnnouncement {
  id           String   @id @default(cuid())
  pricelistId  String
  pricelist    Pricelist @relation(fields: [pricelistId], references: [id], onDelete: Cascade)
  // null = כל הנקודות במכירה
  pointId      String?
  point        DeliveryPoint? @relation(fields: [pointId], references: [id], onDelete: Cascade)

  text         String
  isActive     Boolean  @default(true)
  // תפוגה אוטומטית: הודעה על חלוקה של אתמול לא צריכה להישמע היום
  expiresAt    DateTime?

  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([pricelistId, isActive])
  @@index([pointId])
}

// §51: תכנון ההזמנה לספק - ההחלטה של המנהל כמה קרטונים להזמין.
//
// למה זה נשמר ולא מחושב: ההמרה מיחידות/בודדים לקרטונים היא *החלטה
// אנושית*, לא נוסחה. 38 יחידות בקרטון של 12 יכולות להיות 3 קרטונים
// (חוסר 2) או 4 (עודף 10), והמנהל בוחר לפי שיקול דעת - מה עדיף לו
// באותה מכירה.
//
// בלי שמירה, ההחלטה חיה רק בקובץ האקסל שהמנהל הוריד, והמסך והקובץ
// לא מסכימים. עם שמירה - שניהם מציגים את אותו מספר, וההחלטה זמינה
// גם למכירה הבאה כנקודת ייחוס.
//
// pointId ריק = ההחלטה היא לכלל המכירה (הגיליון המרכז).
model SupplierOrderPlan {
  id          String   @id @default(cuid())
  pricelistId String
  pricelist   Pricelist @relation(fields: [pricelistId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  // ⚠️ scope במקום pointId nullable.
  // הבעיה: ב-Postgres, @@unique עם עמודה שערכה NULL אינו אוכף
  // ייחודיות - שתי שורות עם NULL נחשבות שונות. לכן upsert על תכנון
  // כולל ("כל הנקודות") היה יוצר שורה חדשה בכל שמירה במקום לעדכן,
  // וההחלטה של המנהל הייתה נעלמת.
  //
  // הפתרון: scope הוא מזהה הנקודה, או "ALL" לתכנון הכולל. הוא לעולם
  // אינו NULL ולכן האילוץ עובד. pointId נשאר nullable לקשר עצמו.
  scope       String
  pointId     String?
  point       DeliveryPoint? @relation(fields: [pointId], references: [id], onDelete: Cascade)

  // כמה קרטונים להזמין כדי לכסות את היחידות/בודדים (עמודה E)
  extraCartons  Decimal  @default(0) @db.Decimal(10, 2)
  // כמה יחידות/ק"ג נכנסים בקרטון - לחישוב העודף (עמודה G).
  // נשמר כי לא תמיד ניתן לגזור אותו מהמוצר, והמנהל יודע.
  unitsPerCarton Decimal? @db.Decimal(10, 2)

  updatedBy   String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([pricelistId, productId, scope])
  @@index([pricelistId])
}

// ═══════════════════════════════════════════════════════════════
// §62: יומן פעולות מנהל
// ═══════════════════════════════════════════════════════════════
// כל פעולה רגישה של מנהל/נציג נרשמת: צפייה בקוד, שינוי קוד, כניסה
// בשם משתמש, שינוי טלפון/מייל, השבתת חשבון.
//
// ⚠️ כלל ברזל: **הקוד עצמו לעולם לא נכתב כאן** ולא בשום לוג אחר.
// נרשם רק שהקוד נצפה/שונה, לא מה הוא. meta מיועד לפרטים לא-רגישים
// (למשל "changed point from X to Y") ולכן אסור להעביר אליו סודות.
model AdminAuditLog {
  id         String   @id @default(cuid())
  // מי ביצע
  actorId    String
  actorRole  String
  actorName  String?
  // מה בוצע - VIEW_CODE / SET_CODE / IMPERSONATE_START / IMPERSONATE_STOP /
  // UPDATE_CUSTOMER / TOGGLE_ACTIVE / CHANGE_PAYMENT_PREF
  action     String
  // על מי
  targetType String   @default("Customer")
  targetId   String?
  targetName String?
  // פרטים לא-רגישים בלבד, כ-JSON
  meta       String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetId])
  @@index([action])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════
// §62: כרטיס כניסה בשם משתמש (Login As)
// ═══════════════════════════════════════════════════════════════
// המנהל לוחץ "כניסה כמשתמש" -> השרת מנפיק כרטיס חד-פעמי קצר-מועד,
// והקליינט פודה אותו מול provider ייעודי ב-Auth.js.
//
// למה כרטיס במסד ולא פשוט להחליף את ה-JWT: ה-JWT נחתם בצד השרת של
// Auth.js בלבד, ו-route רגיל לא יכול לכתוב אליו. הכרטיס הוא הדרך
// הבטוחה להעביר את ההרשאה - הוא חד-פעמי (usedAt), פג תוך דקה,
// ומתועד. בלעדיו היינו נאלצים לסמוך על ערך שהקליינט שולח.
model ImpersonationTicket {
  id        String   @id @default(cuid())
  token     String   @unique
  // המשתמש שנכנסים אליו
  targetId  String
  // המנהל שיזם - נשמר ב-JWT כדי לאפשר חזרה
  actorId   String
  actorRole String
  actorName String?
  // כרטיס חזרה: מסיים התחזות ומחזיר את המנהל לעצמו
  isReturn  Boolean  @default(false)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([expiresAt])
}
